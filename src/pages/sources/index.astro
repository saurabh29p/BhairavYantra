---
import Bi from '../../components/Bi.astro';
import PageHeading from '../../components/PageHeading.astro';
import Pending from '../../components/Pending.astro';
import { UI } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title={UI.sources.en} titleHi={UI.sources.hi}>
  <PageHeading en={UI.sources.en} hi={UI.sources.hi} />
  <Pending block what="Sources & Method page, built in Phase 1 from docs/01-methodology-and-sources.md without changing its wording" />
  <h2 id="grades"><Bi label={UI.grades} /></h2>
  <p>A · A‑w · B · C · D · ⚠</p>
  <Pending block what="Grade definitions (GradeLegend, Phase 2), from methodology §2" />
  <ul class="entry-list">
    <li><a href="/sources/bibliography/"><Bi label={UI.bibliography} /></a></li>
    <li><a href="/claims/"><Bi label={UI.claims} /></a></li>
    <li><a href="/corrections/"><Bi label={UI.corrections} /></a></li>
  </ul>
</BaseLayout>
