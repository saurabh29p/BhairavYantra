---
import { getCollection } from 'astro:content';
import CollectionList from '../../components/CollectionList.astro';
import PageHeading from '../../components/PageHeading.astro';
import { UI } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('claim')).sort((a, b) => b.data.opened_on.localeCompare(a.data.opened_on));
const items = entries.map((e) => ({
  href: `/claims/${e.id}/`,
  latin: e.data.statement_en ?? e.data.statement_hi ?? e.id,
  note: `${e.data.status} · opened ${e.data.opened_on}`,
}));
---
<BaseLayout title={UI.claims.en} titleHi={UI.claims.hi}>
  <PageHeading en="Claims under review" hi={UI.claims.hi} />
  <p class="muted"><span lang="en">Statements that are disputed or not yet verified, with the evidence for and against (concept §4.7).</span></p>
  <CollectionList items={items} />
</BaseLayout>
