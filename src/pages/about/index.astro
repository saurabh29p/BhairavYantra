---
/**
 * About & Ethics (bhūpura gate 4): purpose, mantra policy, corrections and contact
 * (concept §3). The page's own words must be the owner's, so each section is a visible
 * placeholder until supplied. Fixed texts already decided in the docs are shown as given.
 */
import Bi from '../../components/Bi.astro';
import PageHeading from '../../components/PageHeading.astro';
import Pending from '../../components/Pending.astro';
import { UI } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title={UI.about.en} titleHi={UI.about.hi}>
  <PageHeading en={UI.about.en} hi={UI.about.hi} />

  <section aria-labelledby="purpose">
    <!-- Heading wording from docs/01-methodology-and-sources.md §1. -->
    <h2 id="purpose"><Bi en="Purpose" hi="उद्देश्य" /></h2>
    <Pending block what="Purpose of the site, in the owner's words (English and Hindi)" />
  </section>

  <section aria-labelledby="ethics">
    <!-- Heading wording from docs/00-concept.md §8. -->
    <h2 id="ethics"><Bi en="Sacred, respectful design and ethics" hi="पवित्रता, सम्मान और नैतिकता" /></h2>
    <Pending block what="Ethics statement in the owner's words: documentation not instruction, living persons, lineages, sensitive practices, no commerce (concept §8)" />
  </section>

  <section aria-labelledby="mantras">
    <!-- Heading wording from docs/00-concept.md §8.2. -->
    <h2 id="mantras"><Bi en="Mantra display" hi="मंत्र प्रदर्शन" /></h2>
    <p lang="en">Every mantra on this site is shown with this note (concept §8.2):</p>
    <blockquote class="fixed-note">
      <p lang="en">Recorded from [text, location]. Traditionally, mantras are received through dīkṣā from a qualified guru; this page documents what the text says and is not a substitute for that.</p>
      <p><Pending what="Hindi wording of the note" /></p>
    </blockquote>
    <Pending block what="Mantra policy in the owner's words (display style is still an open decision)" />
  </section>

  <section aria-labelledby="checking">
    <h2 id="checking"><Bi en="How the content is checked" hi="सामग्री की जाँच कैसे होती है" /></h2>
    <ul>
      <li><a href="/sources/"><Bi label={UI.sources} /></a></li>
      <li><a href="/sources/#grades"><Bi label={UI.grades} /></a></li>
      <li><a href="/claims/"><Bi label={UI.claims} /></a></li>
      <li><a href="/corrections/"><Bi label={UI.corrections} /></a></li>
    </ul>
  </section>

  <section aria-labelledby="contact">
    <h2 id="contact"><Bi en="Contact" hi="संपर्क" /></h2>
    <Pending block what="Contact details: the owner's decision" />
  </section>
</BaseLayout>

<style>
  .fixed-note {
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-inline-start: 3px solid var(--gold);
    background: var(--surface);
  }
  .fixed-note p:last-child {
    margin-bottom: 0;
  }
</style>
