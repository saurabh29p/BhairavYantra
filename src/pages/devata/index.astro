---
import { getCollection } from 'astro:content';
import CollectionList from '../../components/CollectionList.astro';
import PageHeading from '../../components/PageHeading.astro';
import { UI } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byIast } from '../../lib/text';

const entries = (await getCollection('devata')).sort(byIast((e) => e.data.name_iast));
const items = entries.map((e) => ({
  href: `/devata/${e.id}/`,
  sa: e.data.name_sa,
  latin: e.data.name_iast,
  note: e.data.type,
}));
---
<BaseLayout title={UI.devata.en} titleHi={UI.devata.hi}>
  <PageHeading en={UI.devata.en} hi={UI.devata.hi} />
  <p class="muted"><span lang="en">Deities and forms.</span></p>
  <CollectionList items={items} />
</BaseLayout>
