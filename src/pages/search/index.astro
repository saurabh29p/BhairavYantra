---
/**
 * Search (bhūpura gate 1), using the Pagefind index built after the site (concept §11).
 * Spelling variants and synonyms are expanded before searching (src/lib/search.ts).
 * Works from a plain form submit too: /search/?q=…
 */
import Bi from '../../components/Bi.astro';
import PageHeading from '../../components/PageHeading.astro';
import { UI } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title={UI.search.en} titleHi={UI.search.hi} searchable={false}>
  <PageHeading en={UI.search.en} hi={UI.search.hi} />
  <form class="search-form" action="/search/" method="get" role="search" data-search-form>
    <label for="q"><span lang="en">Search the library</span> · <span lang="hi">ग्रंथालय में खोजें</span></label>
    <div class="search-form__row">
      <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" />
      <button type="submit"><Bi label={UI.search} /></button>
    </div>
    <p class="muted search-form__hint">
      <span lang="en">Any spelling works: IAST (Kālī), plain letters (Kali), popular spellings (Bhairo) or Devanāgarī (भैरव).</span>
    </p>
  </form>
  <p class="search-status" role="status" aria-live="polite" data-search-status></p>
  <ol class="search-results" data-search-results></ol>
  <noscript><p><span lang="en">Search needs JavaScript. Every page is also listed in the</span> <a href="/a-z/"><Bi label={UI.az} /></a>.</p></noscript>
  <p class="muted"><a href="/a-z/"><Bi label={UI.az} /></a></p>
</BaseLayout>

<script>
  import { expandQuery, type SynonymGroups } from '../../lib/search';

  type Result = { id: string; score: number; data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }> };
  type Pagefind = { search: (q: string) => Promise<{ results: Result[] }> };

  const form = document.querySelector<HTMLFormElement>('[data-search-form]')!;
  const input = form.querySelector<HTMLInputElement>('input[name="q"]')!;
  const status = document.querySelector<HTMLElement>('[data-search-status]')!;
  const list = document.querySelector<HTMLOListElement>('[data-search-results]')!;

  let pagefind: Pagefind | undefined;
  let groups: SynonymGroups = [];

  async function setup(): Promise<boolean> {
    if (pagefind) return true;
    try {
      const path = '/pagefind/pagefind.js';
      pagefind = (await import(/* @vite-ignore */ path)) as Pagefind;
      groups = ((await (await fetch('/search/synonyms.json')).json()) as { groups: SynonymGroups }).groups;
      return true;
    } catch {
      status.textContent = 'The search index is created when the site is built (npm run build), so search does not work in the development server.';
      return false;
    }
  }

  let run = 0;
  async function search(query: string) {
    const mine = ++run;
    list.replaceChildren();
    if (!query.trim()) {
      status.textContent = '';
      return;
    }
    if (!(await setup()) || !pagefind) return;
    const variants = expandQuery(query, groups);
    const merged = new Map<string, Result>();
    for (const v of variants) {
      for (const r of (await pagefind.search(v)).results) {
        const prev = merged.get(r.id);
        if (!prev || r.score > prev.score) merged.set(r.id, r);
      }
    }
    if (mine !== run) return;
    const results = [...merged.values()].sort((a, b) => b.score - a.score).slice(0, 30);
    const data = await Promise.all(results.map((r) => r.data()));
    if (mine !== run) return;
    for (const d of data) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = d.url;
      a.textContent = d.meta.title ?? d.url;
      const p = document.createElement('p');
      p.className = 'search-results__excerpt';
      p.innerHTML = d.excerpt; // Pagefind's escaped excerpt with <mark> highlights
      li.append(a, p);
      list.append(li);
    }
    status.textContent = data.length === 0 ? `No results for “${query}”.` : `${data.length} result${data.length === 1 ? '' : 's'} for “${query}”.`;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value;
    history.replaceState(null, '', q ? `?q=${encodeURIComponent(q)}` : location.pathname);
    void search(q);
  });
  let timer: number | undefined;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => void search(input.value), 250);
  });

  const initial = new URLSearchParams(location.search).get('q');
  if (initial) {
    input.value = initial;
    void search(initial);
  }
</script>

<style>
  .search-form label {
    display: block;
    margin-bottom: var(--space-2);
  }
  .search-form__row {
    display: flex;
    gap: var(--space-2);
  }
  .search-form input {
    flex: 1;
    min-width: 0;
    font: inherit;
    padding: var(--space-2) var(--space-3);
    min-height: 2.75rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--ink-muted);
    border-radius: var(--radius);
  }
  .search-form button {
    font: inherit;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    color: var(--bg);
    background: var(--sindura);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
  }
  .search-form__hint {
    font-size: 0.9rem;
    margin-top: var(--space-2);
  }
  .search-results {
    padding-inline-start: var(--space-6);
  }
  .search-results :global(li) {
    margin-bottom: var(--space-4);
  }
  .search-results :global(.search-results__excerpt) {
    margin: var(--space-1) 0 0;
    font-size: 0.95rem;
  }
  .search-results :global(mark) {
    background: var(--pending-bg);
    color: var(--pending-ink);
  }
</style>
