---
/** Page title in English and Hindi/Devanāgarī, both visible. */
interface Props {
  en: string;
  hi?: string;
  /** Language of the Devanāgarī line ("hi" Hindi, "sa" Sanskrit). */
  hiLang?: 'hi' | 'sa';
}
const { en, hi, hiLang = 'hi' } = Astro.props;
---
<h1 class="page-heading">
  {hi && <span lang={hiLang} class="page-heading__hi">{hi}</span>}
  <span lang="en" class="page-heading__en">{en}</span>
</h1>

<style>
  .page-heading > span {
    display: block;
  }
  .page-heading__hi {
    line-height: 1.5;
  }
  .page-heading__hi + .page-heading__en {
    font-size: 0.62em;
    font-weight: 500;
    color: var(--ink-muted);
    margin-top: var(--space-1);
  }
</style>
