{
  "name": "bhairavyantra",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:fixtures": "BY_CONTENT_ROOT=tests/fixtures/content BY_OUT_DIR=dist-fixtures astro build",
    "preview": "astro preview",
    "check:content": "tsx scripts/check-content.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:a11y": "tsx scripts/a11y.ts",
    "test": "node --import tsx --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "screenshots": "tsx scripts/screenshots.ts",
    "ci": "npm run check:content && npm test && npm run build && npm run build:fixtures && npm run check:links -- dist dist-fixtures && npm run check:a11y -- dist dist-fixtures"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@fontsource-variable/noto-serif-devanagari": "^5.3.0",
    "@fontsource/tiro-devanagari-sanskrit": "^5.3.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^22.20.5",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
